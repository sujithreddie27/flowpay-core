{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "title": "Alert Status Overview",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "OK", "color": "green" } } },
            { "type": "range", "options": { "from": 1, "to": 999, "result": { "text": "FIRING", "color": "red" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "ALERTS{alertname=~\"FlowPay.*\", alertstate=\"firing\"}",
          "legendFormat": "{{ alertname }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Payment Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(payment_transactions_total{status=\"FAILED\"}[5m])) / sum(rate(payment_transactions_total[5m]))",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ],
      "alert": {
        "name": "High Payment Error Rate",
        "conditions": [
          {
            "evaluator": { "type": "gt", "params": [0.05] },
            "operator": { "type": "and" },
            "query": { "params": ["A", "5m", "now"] },
            "reducer": { "type": "avg" },
            "type": "query"
          }
        ],
        "frequency": "30s",
        "for": "2m",
        "notifications": [{ "uid": "slack-payments" }, { "uid": "pagerduty-critical" }]
      }
    },
    {
      "title": "Transaction Processing Latency (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1.0 },
              { "color": "red", "value": 2.0 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(payment_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(payment_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(payment_processing_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "C"
        }
      ],
      "alert": {
        "name": "High Latency P99",
        "conditions": [
          {
            "evaluator": { "type": "gt", "params": [2.0] },
            "operator": { "type": "and" },
            "query": { "params": ["A", "5m", "now"] },
            "reducer": { "type": "avg" },
            "type": "query"
          }
        ],
        "frequency": "30s",
        "for": "3m",
        "notifications": [{ "uid": "slack-payments" }, { "uid": "pagerduty-critical" }]
      }
    },
    {
      "title": "Database Connection Pool Utilization",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.70 },
              { "color": "red", "value": 0.85 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{pool=\"FlowPayHikariPool-Prod\"} / hikaricp_connections_max{pool=\"FlowPayHikariPool-Prod\"}",
          "legendFormat": "Pool Utilization",
          "refId": "A"
        }
      ]
    },
    {
      "title": "DB Connection Pool Details",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active{pool=\"FlowPayHikariPool-Prod\"}",
          "legendFormat": "Active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{pool=\"FlowPayHikariPool-Prod\"}",
          "legendFormat": "Idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_max{pool=\"FlowPayHikariPool-Prod\"}",
          "legendFormat": "Max",
          "refId": "C"
        },
        {
          "expr": "hikaricp_connections_pending{pool=\"FlowPayHikariPool-Prod\"}",
          "legendFormat": "Pending",
          "refId": "D"
        }
      ],
      "alert": {
        "name": "DB Pool Exhaustion",
        "conditions": [
          {
            "evaluator": { "type": "gt", "params": [0.85] },
            "operator": { "type": "and" },
            "query": { "params": ["A", "2m", "now"] },
            "reducer": { "type": "avg" },
            "type": "query"
          }
        ],
        "frequency": "30s",
        "for": "2m",
        "notifications": [{ "uid": "slack-platform" }, { "uid": "pagerduty-critical" }]
      }
    },
    {
      "title": "Pod Restarts",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 30, "drawStyle": "bars" }
        }
      },
      "targets": [
        {
          "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"flowpay\", container=\"flowpay-core\"}[15m])",
          "legendFormat": "{{ pod }}",
          "refId": "A"
        }
      ],
      "alert": {
        "name": "Pod Restarts",
        "conditions": [
          {
            "evaluator": { "type": "gt", "params": [0] },
            "operator": { "type": "and" },
            "query": { "params": ["A", "15m", "now"] },
            "reducer": { "type": "max" },
            "type": "query"
          }
        ],
        "frequency": "1m",
        "for": "0m",
        "notifications": [{ "uid": "slack-platform" }]
      }
    },
    {
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "red", "value": 10000 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(kafka_consumer_lag{group=\"flowpay-consumer-group\"}) by (topic)",
          "legendFormat": "{{ topic }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Payment Failures by Reason",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": "${DS_PROMETHEUS}",
      "targets": [
        {
          "expr": "sum(increase(payment_failures_total[1h])) by (reason)",
          "legendFormat": "{{ reason }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "SLO: Payment Success Rate (target: 99.9%)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 28 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.995 },
              { "color": "green", "value": 0.999 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(payment_transactions_total{status=\"COMPLETED\"}[1h])) / sum(rate(payment_transactions_total[1h]))",
          "legendFormat": "Success Rate",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Active Transactions (Gauge)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 28 },
      "datasource": "${DS_PROMETHEUS}",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "payment_active_transactions_count",
          "legendFormat": "Active Transactions",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["flowpay", "alerting", "production"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "FlowPay - Alerting & SLO Dashboard",
  "uid": "flowpay-alerting",
  "version": 1
}
